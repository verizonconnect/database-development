[sqlfluff]
dialect = mysql
templater = placeholder
rules = aliasing.column,aliasing.table,capitalisation.functions,capitalisation.identifiers,capitalisation.keywords,convention.naming.column,convention.naming.constraint.check,convention.naming.constraint.default,convention.naming.constraint.foreign_key,convention.naming.constraint.primary_key,convention.naming.constraint.unique,convention.naming.function,convention.naming.index,convention.naming.procedure,convention.naming.sequence,convention.naming.table,convention.naming.trigger,convention.naming.view,layout.commas,layout.indentation

[sqlfluff:templater:placeholder]
param_style = dollar
flyway:defaultschema = sch
flyway:database = db
database_name = db
environment_name = build

[sqlfluff:rules:layout.indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:layout.commas]
comma_style = leading

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = snake_case

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:convention.naming.table]
pattern = ^[a-z0-9_]+$

[sqlfluff:rules:convention.naming.view]
pattern = ^vw_[a-z0-9_]+$

[sqlfluff:rules:convention.naming.sequence]
pattern = ^sq_[a-z0-9_]+$

[sqlfluff:rules:convention.naming.constraint.primary_key]
pattern = ^pk_[a-z0-9_]+$

[sqlfluff:rules:convention.naming.constraint.check]
pattern = ^ck_[a-z0-9_]+__[a-z0-9_]+$

[sqlfluff:rules:convention.naming.constraint.foreign_key]
pattern = ^fk_[a-z0-9_]+__[a-z0-9_]+(_[0-9]+)$

[sqlfluff:rules:convention.naming.constraint.unique]
pattern = ^uq_[a-z0-9_]+__[a-z0-9_]+_[0-9]+$

[sqlfluff:rules:convention.naming.constraint.default]
pattern = ^df_[a-z0-9_]+__[a-z0-9_]+$

[sqlfluff:rules:convention.naming.index]
pattern = ^(cs_|idx_|xml_)[a-z0-9_]+__[a-z0-9_]+_[0-9]+$

[sqlfluff:rules:convention.naming.procedure]
pattern = ^(get|set|add|del|check|validate|perform)_[a-z0-9_]+(__[a-z0-9_]+)?$

[sqlfluff:rules:convention.naming.function]
pattern = ^fn_(get|set|add|del|check|validate|perform)_[a-z0-9_]+(__[a-z0-9_]+)?$

[sqlfluff:rules:convention.naming.trigger]
pattern = ^tg_(get|set|add|del|check|validate|perform)_[a-z0-9_]+(__[a-z0-9_]+)?$

[sqlfluff:rules:convention.naming.column]
pattern = ^[a-z0-9_]+((_((utc|local)))?_when|(_((second|minute|hour|day|week|month|year|euro|dollar)))?_total|_id|_status|_num|_name|_seq|_date|_tally|_size|_addr|_ind|_desc|_doc|_code)$

