# Connection Details
database_name=human_resources
user=root
password=flyway
host_port=3307

# Database Container 
container_name=mysql_container
image=../../docker-buildfiles/mysql

# Flyway 
flyway_image=flyway/flyway:11-Alpine
# Flyway migrate command [migrate, repair, info]
flyway_command=migrate
default_schema=human_resources
sql_migration_prefix=v
repeatable_sql_migration_prefix=r
mixed=true

# Flyway Placeholders
# These values will be substituted at deploy time
environment_name=build

# Sqlfluff rules generation
generate_rules_image=../../docker-buildfiles/generate_rules

# Sqlfluff
# static analysis controls
sqlfluff_image=../../docker-buildfiles/sqlfluff_rules
# lint_verbosity in [-v, -vv, -vvv, -vvvv]
lint_verbosity=-v
lint_output_path=/lint/sqlfluff.output
UID=1000
GID=1000

# Unit Testing
tap_installer=../../docker-buildfiles/tap_installer

